{
  "name": "jsp-scaffold",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "functions:install": "npm --prefix functions install",
    "deploy:rules": "firebase deploy --only firestore:rules,storage",
    "deploy:functions": "npm run functions:install && firebase deploy --only functions",
    "deploy:backend": "npm run functions:install && firebase deploy --only firestore:rules,storage,functions"
  },
  "dependencies": {
    "@duffel/components": "^3.17.0",
    "@expo-google-fonts/nunito": "0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-ml-kit/text-recognition": "2.0.0",
    "@tanstack/react-query": "^5.101.2",
    "expo": "^57.0.6",
    "expo-background-task": "~57.0.4",
    "expo-blur": "~57.0.2",
    "expo-calendar": "~57.0.1",
    "expo-camera": "~57.0.2",
    "expo-constants": "~57.0.5",
    "expo-dev-client": "~57.0.6",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-image-picker": "~57.0.4",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.3",
    "expo-local-authentication": "~57.0.1",
    "expo-location": "~57.0.4",
    "expo-notifications": "~57.0.5",
    "expo-print": "~57.0.1",
    "expo-router": "~57.0.6",
    "expo-secure-store": "~57.0.1",
    "expo-sensors": "~57.0.2",
    "expo-sharing": "~57.0.5",
    "expo-speech": "~57.0.1",
    "expo-speech-recognition": "^56.0.1",
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-task-manager": "~57.0.4",
    "expo-web-browser": "~57.0.1",
    "firebase": "^11.10.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "^13.16.1",
    "react-native-worklets": "0.10.0",
    "zustand": "^5.0.14",
    "expo-image-manipulator": "~57.0.4",
    "expo-navigation-bar": "~57.0.2",
    "expo-glass-effect": "~57.0.1",
    "expo-mesh-gradient": "~57.0.1",
    "@sentry/react-native": "~7.11.0"
  },
  "devDependencies": {
    "@bacons/apple-targets": "^4.0.7",
    "@expo/config-plugins": "^57.0.5",
    "@types/jest": "~29.5.14",
    "@types/react": "~19.2.0",
    "babel-preset-expo": "~57.0.3",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "flight-live-activity",
          "@react-native-ml-kit/text-recognition"
        ]
      }
    }
  },
  "private": true
}
