{
  "name": "jsp-scaffold",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "functions:install": "npm --prefix functions install",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "deploy:functions": "npm run functions:install && firebase deploy --only functions",
    "deploy:backend": "npm run functions:install && firebase deploy --only firestore:rules,functions"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-voice/voice": "^3.2.4",
    "@tanstack/react-query": "^5.101.2",
    "expo": "^56.0.15",
    "expo-calendar": "~56.0.9",
    "expo-constants": "~56.0.20",
    "expo-dev-client": "~56.0.22",
    "expo-font": "~56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.11",
    "expo-image-picker": "~56.0.20",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.15",
    "expo-local-authentication": "~56.0.4",
    "expo-print": "~56.0.4",
    "expo-router": "~56.2.14",
    "expo-secure-store": "~56.0.4",
    "expo-sharing": "~56.0.21",
    "expo-speech": "~56.0.3",
    "expo-splash-screen": "~56.0.12",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.6",
    "expo-system-ui": "~56.0.5",
    "expo-web-browser": "~56.0.5",
    "firebase": "^11.10.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@bacons/apple-targets": "^4.0.7",
    "@types/jest": "~29.5.14",
    "@types/react": "~19.2.0",
    "babel-preset-expo": "~56.0.17",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~56.0.4",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.5",
    "typescript": "~6.0.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": ["flight-live-activity"]
      }
    }
  },
  "private": true
}
