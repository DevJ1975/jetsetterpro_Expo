# Supabase — reuse the SAME project as the native iOS app (shared schema-v1:
# public.trips + public.expenses, anonymous-first GoTrue auth, RLS on auth.uid()).
# The anon key is safe to ship to clients (RLS enforces per-user access).
# Copy this file to `.env.local` and fill in real values (git-ignored).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# NOTE: sensitive third-party keys (Anthropic, Amadeus, Google Vision, FlightAware,
# Expedia) must NOT live here — a RN bundle is extractable. They belong behind
# Supabase Edge Functions / the Duffel proxy and are added in later phases.
