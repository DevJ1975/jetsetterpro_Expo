# Firebase — the JetSetter Pro backend (project: jetsetter-pro).
# The web config (apiKey, projectId, …) is client-PUBLIC by design — it is
# committed as defaults in src/core/firebase/config.ts, so the app works
# out-of-the-box. Set these only to OVERRIDE the defaults (e.g. a staging project).
# Access is enforced by Firestore Security Rules (see firebase/firestore.rules).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Live IRIS: the deployed `aiIris` Cloud Function URL (holds the Anthropic key
# server-side). Until this is set, IRIS uses the built-in demo responses.
#   e.g. https://us-central1-jetsetter-pro.cloudfunctions.net/aiIris
EXPO_PUBLIC_AI_ENDPOINT=
