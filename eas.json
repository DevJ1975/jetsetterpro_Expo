{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "24.16.0",
      "ios": { "simulator": true },
      "env": {}
    },
    "preview": {
      "distribution": "internal",
      "node": "24.16.0",
      "ios": { "simulator": true },
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://us-central1-jetsetter-pro.cloudfunctions.net",
        "EXPO_PUBLIC_AI_ENDPOINT": "https://us-central1-jetsetter-pro.cloudfunctions.net/aiIris"
      }
    },
    "production": {
      "autoIncrement": true,
      "node": "24.16.0",
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://us-central1-jetsetter-pro.cloudfunctions.net",
        "EXPO_PUBLIC_AI_ENDPOINT": "https://us-central1-jetsetter-pro.cloudfunctions.net/aiIris"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascApiKeyPath": "./credentials/asc-api-key.p8"
      },
      "android": {
        "serviceAccountKeyPath": "./credentials/google-play-service-account.json",
        "track": "internal"
      }
    }
  }
}
