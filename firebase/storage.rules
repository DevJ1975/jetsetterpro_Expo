rules_version = '2';

// Cloud Storage rules — each user reads, writes, and deletes ONLY under their
// own users/{uid}/… tree. Uploads must be images and under 10 MB. Mirrors the
// per-user isolation in firestore.rules.
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == uid;

      // request.resource is null on delete — allow the owner to delete; on
      // create/update enforce image content-type and a size cap.
      allow write: if request.auth != null
        && request.auth.uid == uid
        && (
          request.resource == null
          || (
            request.resource.size < 10 * 1024 * 1024
            && request.resource.contentType.matches('image/.*')
          )
        );
    }
  }
}
