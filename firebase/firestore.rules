rules_version = '2';

// Each user can read/write ONLY their own subtree (users/{uid}/**). This is the
// security backbone — the client-public Firebase apiKey is safe precisely because
// these rules (like Supabase RLS) enforce per-user ownership. Deploy with:
//   firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Flat mirror of upcoming itinerary flights so the scheduled
    // disruptionWatch function can query them server-side. Each doc is
    // owned by its uid field; the doc id is `{uid}_{IDENT}_{YYYY-MM-DD}`.
    match /flightWatches/{watchId} {
      allow read, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create, update: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    // flightCache/**, usage/**, meta/** have no match on purpose —
    // client-denied; Cloud Functions use the Admin SDK (bypasses rules).
  }
}
