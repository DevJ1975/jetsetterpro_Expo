{
  "expo": {
    "name": "JetSetter Pro",
    "slug": "jetsetter-pro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "jetsetterpro",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#06070D",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.trainovate.jetsetterpro"
    },
    "android": {
      "package": "com.trainovate.jetsetterpro",
      "adaptiveIcon": {
        "backgroundColor": "#06070D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#06070D"
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "JetSetter Pro uses Face ID to unlock your encrypted Document Vault."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "JetSetter Pro adds your trips and flights to your calendar."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock your Document Vault with Face ID."
        }
      ],
      "expo-dev-client"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
