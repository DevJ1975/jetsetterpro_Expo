{
  "expo": {
    "name": "JetSetter Pro",
    "slug": "jetsetter-pro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "jetsetterpro",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#06070D",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.trainovate.jetsetterpro",
      "infoPlist": {
        "LSApplicationQueriesSchemes": ["uber", "lyft"]
      }
    },
    "android": {
      "package": "com.trainovate.jetsetterpro",
      "googleServicesFile": "./firebase/google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#06070D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/nunito/400Regular/Nunito_400Regular.ttf",
            "node_modules/@expo-google-fonts/nunito/500Medium/Nunito_500Medium.ttf",
            "node_modules/@expo-google-fonts/nunito/600SemiBold/Nunito_600SemiBold.ttf",
            "node_modules/@expo-google-fonts/nunito/700Bold/Nunito_700Bold.ttf",
            "node_modules/@expo-google-fonts/nunito/800ExtraBold/Nunito_800ExtraBold.ttf"
          ]
        }
      ],
      "expo-image",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser",
      "react-native-maps",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "JetSetter Pro shows your position on airport and in-flight maps and detects your pickup location for ground transport."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "JetSetter Pro uses the camera to scan boarding-pass barcodes and receipts.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#3B9EF0",
          "defaultChannel": "default"
        }
      ],
      "expo-task-manager",
      "expo-background-task",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#06070D"
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "JetSetter Pro uses Face ID to unlock your encrypted Document Vault."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "JetSetter Pro adds your trips and flights to your calendar."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock your Document Vault with Face ID."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "JetSetter Pro uses the microphone so you can talk to IRIS hands-free.",
          "speechRecognitionPermission": "JetSetter Pro transcribes your speech so IRIS can understand what you ask."
        }
      ],
      "expo-dev-client"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "42dd649a-31eb-4807-b2bd-113cdbe5b634"
      }
    },
    "owner": "jamil.dev"
  }
}
